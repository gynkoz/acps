---
import { ClientRouter } from 'astro:transitions';
interface Props {
  page: string;
  titleId: string;
  titleEn: string;
  descId: string;
  descEn: string;
  footerKey: string;
}
const { page, titleId, titleEn, descId, descEn, footerKey } = Astro.props;
---
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" id="meta-desc" content={descId} data-id={descId} data-en={descEn} />
  <title>{titleId}</title>
  <noscript><style>.reveal { opacity: 1 !important; transform: none !important; }</style></noscript>
  <ClientRouter />
  <script>
    // Anti-FOUC: tema dipasang sebelum paint pertama
    try {
      const t = localStorage.getItem('acps-theme');
      const dark = t ? t === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
    } catch { document.documentElement.setAttribute('data-theme', 'light'); }
  </script>
</head>
<body data-page={page}>
  <!-- Latar futuristik: grid perspektif + aurora + bintang -->
  <div class="bg" aria-hidden="true">
    <div class="bg-grid"></div>
    <div class="bg-aurora a1"></div>
    <div class="bg-aurora a2"></div>
    <div class="bg-aurora a3"></div>
    <div class="bg-stars"></div>
    <div class="bg-scan"></div>
  </div>

  <div class="controls" data-astro-transition-persist>
    <button id="lang-toggle" class="pill" type="button" aria-label="Ganti bahasa">🇬🇧 EN</button>
    <button id="theme-toggle" class="pill" type="button" aria-label="Ganti tema">🌙</button>
  </div>

  <main id="page-content">
    <slot />
  </main>

  <footer class="site-footer">
    <span data-i18n={footerKey}>© 2026 Andreafif Cyto Prasadana Sutrisno · ACPS — proyek pribadi</span>
  </footer>

  <script>
    import { DICT } from '../i18n';

    const LS_LANG = 'acps-lang';
    const LS_THEME = 'acps-theme';

    /* ---------- Bahasa ---------- */
    function isIndonesia(): boolean {
      const nav = (navigator.language || '').toLowerCase();
      if (nav.startsWith('id')) return true;
      try {
        const tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
        if (/^Asia\/(Jakarta|Makassar|Pontianak|Jayapura|Manokwari)/.test(tz)) return true;
      } catch { /* no Intl */ }
      return false;
    }

    function detectLang(): 'id' | 'en' {
      try {
        const saved = localStorage.getItem(LS_LANG);
        if (saved === 'id' || saved === 'en') return saved;
      } catch { /* private mode */ }
      return isIndonesia() ? 'id' : 'en';
    }

    function applyLang(lang: 'id' | 'en') {
      const dict = DICT[lang];
      document.documentElement.lang = lang;

      document.querySelectorAll<HTMLElement>('[data-i18n]').forEach((el) => {
        const v = dict[el.dataset.i18n as keyof typeof dict];
        if (v) el.textContent = v;
      });
      document.querySelectorAll<HTMLElement>('[data-i18n-html]').forEach((el) => {
        const v = dict[el.dataset.i18nHtml as keyof typeof dict];
        if (v) el.innerHTML = v;
      });

      const page = document.body.dataset.page || 'home';
      const titleKey = `${page}.title` as keyof typeof dict;
      if (dict[titleKey]) document.title = dict[titleKey];

      const meta = document.getElementById('meta-desc');
      if (meta) meta.setAttribute('content', meta.dataset[lang] || '');

      const pill = document.getElementById('lang-toggle');
      if (pill) {
        pill.textContent = lang === 'id' ? '🇬🇧 EN' : '🇮🇩 ID';
        pill.setAttribute('aria-label', lang === 'id' ? 'Switch to English' : 'Ganti ke Bahasa Indonesia');
      }
    }

    /* ---------- Tema ---------- */
    function currentTheme(): 'light' | 'dark' {
      try {
        const saved = localStorage.getItem(LS_THEME);
        if (saved === 'light' || saved === 'dark') return saved;
      } catch { /* private mode */ }
      return matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    }

    function applyTheme(theme: 'light' | 'dark') {
      document.documentElement.setAttribute('data-theme', theme);
      const pill = document.getElementById('theme-toggle');
      if (pill) {
        pill.textContent = theme === 'dark' ? '☀️' : '🌙';
        pill.setAttribute('aria-label', theme === 'dark' ? 'Switch to light mode' : 'Ganti ke mode gelap');
      }
    }

    /* ---------- Scroll reveal ---------- */
    function reveal(el: HTMLElement, delay: number) {
      el.style.transitionDelay = `${delay}ms`;
      requestAnimationFrame(() => el.classList.add('revealed'));
    }

    function setupReveal(root: ParentNode = document) {
      const els = Array.from(root.querySelectorAll<HTMLElement>('.reveal:not(.revealed)'));
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e, i) => {
          if (e.isIntersecting) {
            const el = e.target as HTMLElement;
            reveal(el, parseInt(el.dataset.delay || '0', 10) + i * 90);
            io.unobserve(el);
          }
        });
      }, { threshold: 0.12 });
      els.forEach((el) => {
        // Elemen yang sudah terlihat saat halaman berganti: reveal langsung,
        // jangan bergantung pada callback IO (bisa di-throttle saat tab background).
        if (el.getBoundingClientRect().top < window.innerHeight * 0.92) {
          reveal(el, parseInt(el.dataset.delay || '0', 10));
        } else {
          io.observe(el);
        }
      });
    }

    /* ---------- Tilt 3D pada kartu ---------- */
    function setupTilt(root: ParentNode = document) {
      root.querySelectorAll<HTMLElement>('.tilt').forEach((card) => {
        if (card.dataset.tiltBound) return;
        card.dataset.tiltBound = '1';
        card.addEventListener('pointermove', (ev) => {
          const r = card.getBoundingClientRect();
          const x = (ev.clientX - r.left) / r.width - 0.5;
          const y = (ev.clientY - r.top) / r.height - 0.5;
          card.style.transform = `perspective(900px) rotateX(${(-y * 7).toFixed(2)}deg) rotateY(${(x * 9).toFixed(2)}deg) translateY(-4px)`;
          card.style.setProperty('--mx', `${((x + 0.5) * 100).toFixed(1)}%`);
          card.style.setProperty('--my', `${((y + 0.5) * 100).toFixed(1)}%`);
        });
        card.addEventListener('pointerleave', () => {
          card.style.transform = '';
        });
      });
    }

    /* ---------- Init ---------- */
    function initAll() {
      applyLang(detectLang());
      applyTheme(currentTheme());
      setupReveal();
      setupTilt();
    }

    document.getElementById('lang-toggle')?.addEventListener('click', () => {
      const next = document.documentElement.lang === 'id' ? 'en' : 'id';
      try { localStorage.setItem(LS_LANG, next); } catch { /* noop */ }
      applyLang(next as 'id' | 'en');
    });

    document.getElementById('theme-toggle')?.addEventListener('click', () => {
      const next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      try { localStorage.setItem(LS_THEME, next); } catch { /* noop */ }
      applyTheme(next as 'light' | 'dark');
    });

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll);
    } else {
      initAll();
    }

    // Setelah page transition Astro: animasi ulang konten baru
    document.addEventListener('astro:page-load', initAll);
  </script>

  <style is:global>
    /* ============ TOKEN ============ */
    :root {
      --mint: #34D399;
      --emerald: #10B981;
      --deep: #059669;
      --cyan: #22D3EE;
      --violet: #8B5CF6;

      --bg: #05080F;
      --bg-soft: rgba(13, 22, 38, .62);
      --text: #E8F1F8;
      --muted: #8FA3BC;
      --border: rgba(52, 211, 153, .16);
      --glow: rgba(16, 185, 129, .35);
      --card: rgba(10, 18, 32, .55);
      --shadow: 0 18px 50px rgba(0, 0, 0, .45);
      --radius: 22px;
    }
    [data-theme="light"] {
      --bg: #F2F7F6;
      --bg-soft: rgba(255, 255, 255, .78);
      --text: #0B1E1A;
      --muted: #4E6A63;
      --border: rgba(5, 150, 105, .18);
      --glow: rgba(16, 185, 129, .22);
      --card: rgba(255, 255, 255, .66);
      --shadow: 0 18px 44px rgba(4, 47, 36, .12);
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }
    html { scroll-behavior: smooth; }

    body {
      font-family: "Segoe UI Variable Display", "Segoe UI", Inter, system-ui, -apple-system, Roboto, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.7;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
      transition: background .5s ease, color .5s ease;
    }

    main { flex: 1; position: relative; z-index: 1; }
    :focus-visible { outline: 2px solid var(--mint); outline-offset: 3px; border-radius: 6px; }

    /* ============ LATAR FUTURISTIK ============ */
    .bg { position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }

    .bg-grid {
      position: absolute; inset: -50% -50% 0 -50%;
      background-image:
        linear-gradient(var(--border) 1px, transparent 1px),
        linear-gradient(90deg, var(--border) 1px, transparent 1px);
      background-size: 46px 46px;
      transform: perspective(700px) rotateX(58deg) translateY(-14%);
      transform-origin: 50% 100%;
      mask-image: linear-gradient(to top, rgba(0,0,0,.5), transparent 62%);
      -webkit-mask-image: linear-gradient(to top, rgba(0,0,0,.5), transparent 62%);
      animation: grid-move 26s linear infinite;
      opacity: .5;
    }
    @keyframes grid-move { to { background-position: 0 460px; } }

    .bg-aurora {
      position: absolute; border-radius: 50%;
      filter: blur(90px); opacity: .5;
      animation: drift 18s ease-in-out infinite alternate;
      mix-blend-mode: screen;
    }
    [data-theme="light"] .bg-aurora { opacity: .34; mix-blend-mode: multiply; filter: blur(110px); }
    .a1 { width: 55vw; height: 55vw; left: -12vw; top: -18vw; background: radial-gradient(circle, var(--emerald), transparent 65%); }
    .a2 { width: 46vw; height: 46vw; right: -10vw; top: 8vh; background: radial-gradient(circle, var(--cyan), transparent 65%); animation-delay: -6s; animation-duration: 22s; }
    .a3 { width: 40vw; height: 40vw; left: 24vw; bottom: -16vw; background: radial-gradient(circle, var(--violet), transparent 65%); animation-delay: -12s; animation-duration: 26s; }
    @keyframes drift {
      from { transform: translate3d(0, 0, 0) scale(1); }
      to   { transform: translate3d(6vw, 4vh, 0) scale(1.18); }
    }

    .bg-stars {
      position: absolute; inset: 0;
      background-image:
        radial-gradient(1.4px 1.4px at 12% 22%, rgba(255,255,255,.7), transparent 100%),
        radial-gradient(1px 1px at 34% 68%, rgba(255,255,255,.5), transparent 100%),
        radial-gradient(1.6px 1.6px at 58% 14%, rgba(255,255,255,.6), transparent 100%),
        radial-gradient(1px 1px at 72% 48%, rgba(255,255,255,.45), transparent 100%),
        radial-gradient(1.3px 1.3px at 88% 30%, rgba(255,255,255,.6), transparent 100%),
        radial-gradient(1px 1px at 22% 84%, rgba(255,255,255,.4), transparent 100%),
        radial-gradient(1.5px 1.5px at 66% 88%, rgba(255,255,255,.5), transparent 100%);
      animation: twinkle 5.5s ease-in-out infinite alternate;
    }
    [data-theme="light"] .bg-stars { opacity: .18; }
    @keyframes twinkle { from { opacity: .35; } to { opacity: .9; } }

    .bg-scan {
      position: absolute; left: 0; right: 0; height: 140px; top: -140px;
      background: linear-gradient(to bottom, transparent, var(--glow), transparent);
      opacity: .16;
      animation: scan 9s linear infinite;
    }
    @keyframes scan { to { top: 110%; } }

    /* ============ KONTROL ============ */
    .controls {
      position: fixed; top: 18px; right: 18px; z-index: 10;
      display: flex; gap: 10px;
    }
    .pill {
      background: var(--bg-soft);
      border: 1px solid var(--border);
      color: var(--text);
      border-radius: 999px;
      padding: 8px 16px;
      font-size: .88rem; font-weight: 700;
      font-family: inherit;
      cursor: pointer;
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      box-shadow: 0 4px 20px rgba(0,0,0,.18);
      transition: transform .25s cubic-bezier(.2,.9,.3,1.4), box-shadow .25s, border-color .25s;
    }
    .pill:hover {
      transform: translateY(-2px) scale(1.05);
      border-color: var(--mint);
      box-shadow: 0 0 22px var(--glow);
    }

    /* ============ HERO ============ */
    .hero {
      position: relative;
      text-align: center;
      padding: 120px 24px 72px;
    }
    .hero .kicker {
      display: inline-flex; align-items: center; gap: 8px;
      font-size: .8rem; font-weight: 700; letter-spacing: .22em;
      text-transform: uppercase;
      color: var(--mint);
      border: 1px solid var(--border);
      background: var(--bg-soft);
      padding: 7px 18px; border-radius: 999px;
      backdrop-filter: blur(10px);
      margin-bottom: 22px;
      animation: float 5s ease-in-out infinite;
    }
    @keyframes float { 50% { transform: translateY(-6px); } }

    .hero h1 {
      font-size: clamp(2.6rem, 7vw, 4.4rem);
      font-weight: 900;
      letter-spacing: -.03em;
      line-height: 1.08;
      background: linear-gradient(115deg, var(--text) 20%, var(--mint) 48%, var(--cyan) 72%, var(--text) 95%);
      background-size: 220% auto;
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      animation: shine 7s linear infinite;
      filter: drop-shadow(0 0 26px var(--glow));
    }
    @keyframes shine { to { background-position: 220% center; } }

    .hero .sub {
      margin-top: 14px;
      font-size: clamp(1rem, 2.6vw, 1.2rem);
      color: var(--muted);
      max-width: 640px;
      margin-inline: auto;
    }

    /* ============ LAYOUT ============ */
    .wrap { max-width: 960px; margin: 0 auto; padding: 24px 24px 72px; width: 100%; }
    .wrap.narrow { max-width: 840px; }
    .intro { text-align: center; color: var(--muted); font-size: 1.05rem; margin-bottom: 40px; }

    /* ============ KARTU ============ */
    .apps {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 22px;
    }
    .card {
      position: relative;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 28px 26px;
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      box-shadow: var(--shadow);
      overflow: hidden;
      transition: transform .35s cubic-bezier(.2,.9,.3,1.2), box-shadow .35s, border-color .35s;
      will-change: transform;
    }
    .card::before {
      content: "";
      position: absolute; inset: 0;
      background: radial-gradient(340px circle at var(--mx, 50%) var(--my, 50%), var(--glow), transparent 65%);
      opacity: 0; transition: opacity .4s;
      pointer-events: none;
    }
    .card:hover::before { opacity: .55; }
    .card:hover { border-color: var(--mint); box-shadow: 0 0 34px var(--glow), var(--shadow); }
    .card h3 { color: var(--mint); margin-bottom: 8px; font-size: 1.08rem; }
    .card p { font-size: .95rem; color: var(--muted); }

    a.app-card { display: block; color: inherit; text-decoration: none; }
    .app-card .emoji {
      width: 60px; height: 60px;
      display: grid; place-items: center;
      font-size: 1.9rem;
      border-radius: 18px;
      background: linear-gradient(135deg, rgba(52,211,153,.2), rgba(34,211,238,.14));
      border: 1px solid var(--border);
      box-shadow: inset 0 0 18px rgba(52,211,153,.12);
      margin-bottom: 16px;
      animation: float 6s ease-in-out infinite;
    }
    .badge {
      display: inline-flex; align-items: center; gap: 6px;
      margin-top: 14px;
      font-size: .86rem; font-weight: 800;
      color: var(--mint);
      letter-spacing: .04em;
    }
    .soon {
      border-style: dashed;
      display: grid; place-content: center;
      text-align: center;
      color: var(--muted);
      min-height: 190px;
    }

    /* ============ TOMBOL ============ */
    .links { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; margin-top: 44px; }
    .btn {
      position: relative;
      display: inline-block;
      padding: 12px 28px;
      border-radius: 999px;
      border: 1px solid var(--border);
      background: var(--bg-soft);
      color: var(--mint);
      font-weight: 700; font-size: .95rem;
      text-decoration: none;
      backdrop-filter: blur(10px);
      transition: transform .3s cubic-bezier(.2,.9,.3,1.5), box-shadow .3s, border-color .3s;
    }
    .btn:hover { transform: translateY(-3px) scale(1.03); border-color: var(--mint); box-shadow: 0 0 26px var(--glow); }
    .btn.primary {
      background: linear-gradient(120deg, var(--deep), var(--emerald) 55%, var(--cyan));
      background-size: 180% auto;
      color: #fff; border: none;
    }
    .btn.primary:hover { background-position: right center; }

    /* ============ PROSE (legal) ============ */
    .prose h2 {
      color: var(--mint); margin: 38px 0 12px; font-size: 1.32rem;
      letter-spacing: -.01em;
      display: flex; align-items: center; gap: 12px;
    }
    .prose h2::after {
      content: ""; flex: 1; height: 1px;
      background: linear-gradient(90deg, var(--border), transparent);
    }
    .prose p { margin-bottom: 14px; }
    .prose a { color: var(--mint); text-decoration: none; border-bottom: 1px solid var(--border); transition: color .2s ease, border-color .2s ease; }
    .prose a:hover { color: var(--cyan); border-color: var(--cyan); }
    .prose ul { padding-left: 22px; margin-bottom: 16px; }
    .prose li { margin-bottom: 6px; }
    .prose li::marker { color: var(--mint); }
    .prose code {
      background: rgba(52, 211, 153, .12);
      color: var(--mint);
      padding: 2px 8px; border-radius: 7px;
      font-size: .88em;
      border: 1px solid var(--border);
    }
    .updated {
      font-size: .9rem; color: var(--muted);
      border-bottom: 1px solid var(--border);
      padding-bottom: 16px; margin-bottom: 8px;
    }

    /* ============ FOOTER ============ */
    .site-footer {
      position: relative; z-index: 1;
      text-align: center;
      padding: 30px 24px;
      color: var(--muted);
      font-size: .9rem;
      border-top: 1px solid var(--border);
      backdrop-filter: blur(8px);
    }

    /* ============ SCROLL REVEAL ============ */
    .reveal {
      opacity: 0;
      transform: translateY(34px) scale(.985);
      transition: opacity .8s cubic-bezier(.2,.7,.3,1), transform .8s cubic-bezier(.2,.7,.3,1);
    }
    .reveal.revealed { opacity: 1; transform: none; }

    /* ============ PAGE TRANSITION (View Transitions) ============ */
    @keyframes vt-in { from { opacity: 0; transform: translateY(26px) scale(.99); } to { opacity: 1; transform: none; } }
    @keyframes vt-out { from { opacity: 1; } to { opacity: 0; transform: translateY(-18px); } }
    ::view-transition-old(root) { animation: vt-out .28s ease both; }
    ::view-transition-new(root) { animation: vt-in .45s cubic-bezier(.2,.7,.3,1) both; }
    #page-content { view-transition-name: page; animation: vt-in .5s cubic-bezier(.2,.7,.3,1) both; }

    /* ============ REDUCED MOTION ============ */
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { transition: none !important; animation: none !important; }
      html { scroll-behavior: auto; }
      .reveal { opacity: 1; transform: none; }
    }

    @media (max-width: 520px) {
      .hero { padding: 104px 18px 56px; }
      .wrap { padding: 18px 18px 56px; }
      .controls { top: 12px; right: 12px; }
    }
  </style>
</body>
</html>
